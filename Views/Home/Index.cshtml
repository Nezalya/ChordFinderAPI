@{
    ViewData["Title"] = "Chord Finder";
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chord Finder</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #120e0c;
            color: #e6dfda;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        .navbar-custom {
            background-color: #1a1412;
            border-bottom: 1px solid #2a221e;
        }

        .card-custom {
            background-color: #1c1512;
            border: 1px solid #2d231e;
            border-radius: 12px;
        }

        .pill-badge {
            background-color: #2a201b;
            color: #cbbba8;
            border: 1px solid #3d3028;
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 0.85rem;
        }

        .chord-tag {
            background-color: #281f1a;
            color: #d1c2b0;
            border-radius: 8px;
            padding: 4px 10px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }

        .chord-tag.active-chord {
            background-color: #d8965e;
            color: #120e0c;
            font-weight: 700;
        }

        .search-input {
            background-color: #241c18;
            border: 1px solid #382c26;
            color: #fff;
        }

        .search-input:focus {
            background-color: #2a201b;
            border-color: #d8965e;
            color: #fff;
            box-shadow: none;
        }

        .btn-custom {
            background-color: #c98a55;
            color: #120e0c;
            font-weight: 600;
            border-radius: 8px;
        }

        .btn-custom:hover {
            background-color: #db9a63;
            color: #000;
        }

        .text-muted-custom {
            color: #9e8e82;
            font-size: 0.75rem;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
    </style>
</head>
<body>

    <!-- BARRA SUPERIOR -->
    <nav class="navbar navbar-custom py-3 mb-4">
        <div class="container-fluid px-4">
            <span class="navbar-brand fw-bold fs-4 text-light">Chord Finder</span>
            
            <div class="d-flex align-items-center gap-2" style="max-width: 450px; width: 100%;">
                <div class="input-group">
                    <span class="input-group-text search-input border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="inputAcorde" class="form-control search-input border-start-0" placeholder="Ej: G#, Am, Cmaj7..." value="G#">
                </div>
                <button id="btnBuscar" class="btn btn-custom px-4">Buscar</button>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        <!-- ALERT DE ERROR -->
        <div id="errorAlert" class="alert alert-danger d-none my-3" role="alert"></div>

        <!-- SPINNER CARGANDO -->
        <div id="loading" class="text-center d-none my-5">
            <div class="spinner-border text-warning" role="status"></div>
        </div>

        <!-- CONTENIDO PRINCIPAL -->
        <div id="resultados" class="row g-4 d-none">
            
            <!-- PANEL IZQUIERDO: DETALLES DEL ACORDE -->
            <div class="col-lg-3">
                <div class="card-custom p-4 h-100">
                    <div class="mb-4">
                        <span class="text-muted-custom font-monospace">Acorde Buscado</span>
                        <h1 class="display-3 fw-bold text-light mt-1" id="resAcordeBuscado">--</h1>
                    </div>

                    <hr class="border-secondary opacity-25" />

                    <div class="mb-4">
                        <span class="text-muted-custom font-monospace">Notas del Acorde</span>
                        <div class="d-flex gap-2 mt-2" id="resNotasContainer">
                            <!-- Badges de notas agregados dinámicamente -->
                        </div>
                    </div>

                    <hr class="border-secondary opacity-25" />

                    <div>
                        <span class="text-muted-custom font-monospace">Total de Escalas Encontradas</span>
                        <h2 class="fw-bold mt-1 text-light" id="resTotalEscalas">0</h2>
                    </div>
                </div>
            </div>

            <!-- PANEL DERECHO: LISTA DE ESCALAS -->
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Escalas donde aparece el acorde</h5>
                    <span class="text-muted small" id="resContadorHeader">0 resultados</span>
                </div>

                <div class="d-flex flex-column gap-3" id="listaEscalas">
                    <!-- Tarjetas de escalas generadas dinámicamente -->
                </div>
            </div>

        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const inputAcorde = document.getElementById("inputAcorde");
            const btnBuscar = document.getElementById("btnBuscar");
            const loading = document.getElementById("loading");
            const errorAlert = document.getElementById("errorAlert");
            const resultados = document.getElementById("resultados");

            btnBuscar.addEventListener("click", () => ejecutarBusqueda());
            inputAcorde.addEventListener("keypress", (e) => {
                if (e.key === "Enter") ejecutarBusqueda();
            });

            // Búsqueda inicial automática
            ejecutarBusqueda();

            async function ejecutarBusqueda() {
                const acorde = inputAcorde.value.trim();
                if (!acorde) return;

                const acordeEncoded = encodeURIComponent(acorde);
                ocultarPantalla();
                loading.classList.remove("d-none");

                try {
                    const response = await fetch(`/api/Teoria/buscar-escalas-por-acorde/${acordeEncoded}`);
                    if (!response.ok) {
                        if (response.status === 404) throw new Error(`El acorde '${acorde}' no existe en la base de datos.`);
                        throw new Error("Error al consultar el servidor.");
                    }

                    const data = await response.json();
                    renderizarInterfaz(data);
                } catch (err) {
                    mostrarError(err.message);
                } finally {
                    loading.classList.add("d-none");
                }
            }

            function renderizarInterfaz(data) {
                // 1. Panel Izquierdo
                document.getElementById("resAcordeBuscado").innerText = data.acordeBuscado;
                document.getElementById("resTotalEscalas").innerText = data.totalEscalasEncontradas;
                document.getElementById("resContadorHeader").innerText = `${data.totalEscalasEncontradas} resultados`;

                // Notas del acorde (Badges separados)
                const notasContainer = document.getElementById("resNotasContainer");
                notasContainer.innerHTML = "";
                const notasArray = data.notasDelAcorde.split(", ");
                notasArray.forEach(nota => {
                    notasContainer.innerHTML += `<span class="chord-tag fs-6 px-3 py-2">${nota}</span>`;
                });

                // 2. Panel Derecho (Escalas)
                const listaEscalas = document.getElementById("listaEscalas");
                listaEscalas.innerHTML = "";

                data.escalasDondeAparece.forEach(escala => {
                    // Mapear los 7 acordes en su orden armónico I, ii, iii, IV, V, vi, vii°
                    const acordesLista = Array.isArray(escala.acordesDeLaEscala) 
                        ? escala.acordesDeLaEscala 
                        : escala.acordesDeLaEscala.split(", ");

                    const HTMLAcordes = acordesLista.map(acordeNombre => {
                        // Si el acorde de la escala es el que buscó el usuario, resaltarlo en naranja/marrón claro
                        const esElBuscado = acordeNombre.trim().toLowerCase() === data.acordeBuscado.trim().toLowerCase();
                        const claseActiva = esElBuscado ? "active-chord" : "";
                        return `<span class="chord-tag ${claseActiva}">${acordeNombre.trim()}</span>`;
                    }).join(" ");

                    const itemHtml = `
                        <div class="card-custom p-3">
                            <div class="row align-items-center g-3">
                                <!-- Nombre y Tipo -->
                                <div class="col-md-3 d-flex align-items-center gap-2">
                                    <h5 class="fw-bold mb-0 text-light">${escala.nombreEscala}</h5>
                                    <span class="pill-badge">${escala.tipoEscala}</span>
                                </div>

                                <!-- Notas de la Escala -->
                                <div class="col-md-3">
                                    <span class="text-muted-custom d-block">Notas de la escala</span>
                                    <span class="small text-light opacity-75">${escala.notasDeLaEscala}</span>
                                </div>

                                <!-- Acordes de la Escala (Orden I, ii, iii, IV, V, vi, vii°) -->
                                <div class="col-md-5">
                                    <span class="text-muted-custom d-block mb-1">Acordes de la escala</span>
                                    <div class="d-flex flex-wrap gap-1">
                                        ${HTMLAcordes}
                                    </div>
                                </div>

                                <!-- Flecha detalle -->
                                <div class="col-md-1 text-end text-muted">
                                    <i class="bi bi-chevron-right fs-5"></i>
                                </div>
                            </div>
                        </div>
                    `;

                    listaEscalas.insertAdjacentHTML("beforeend", itemHtml);
                });

                resultados.classList.remove("d-none");
            }

            function mostrarError(msg) {
                ocultarPantalla();
                errorAlert.innerText = msg;
                errorAlert.classList.remove("d-none");
            }

            function ocultarPantalla() {
                errorAlert.classList.add("d-none");
                resultados.classList.add("d-none");
            }
        });
    </script>
</body>
</html>